# ── Optional — wizard handles setup in-browser ──
# If you set GEMINI_API_KEY here, the setup wizard skips the key-entry step.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Owner (auto-detected from bridge after QR pairing) ──
# OWNER_PHONE_NUMBER=91XXXXXXXXXX

# ── MeChat — the chat Hermes talks to you in ──
# Selected during setup by sending a pairing code in any chat.
# If you want to pre-configure: MECHAT_JID=91XXXXXXXXXX-XXXXXXX@g.us

# ── Setup Console ───────────────────────────────
# SETUP_PASSWORD=your_secure_password

# ── Bridge paths (defaults below work out of the box) ──
# STORE_DIR=hermes_bot/store
# MESSAGES_DB_PATH=...
# WHATSAPP_DB_PATH=...
# WA_API_URL=http://127.0.0.1:8081
# BRIDGE_PORT=8081

# ── Hermes-specific ──────────────────────────────
# HERMES_DB_PATH=hermes_bot/store/hermes.db
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite-preview
# SESSION_TIMEOUT_MINUTES=60
# MAX_GROUPS_PER_SEARCH=10
# SEARCH_LOOKBACK_DAYS=14
# SEARCH_MESSAGES_PER_GROUP=200

# ── Optional features ────────────────────────────
# CRON_ENABLED=1
# HERMES_TIMEZONE=Asia/Kolkata